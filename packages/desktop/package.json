{
  "name": "@dsh-orb/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Silent desktop control for the orb's background agent, backed by the agent-desktop FFI library.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "native"
  ],
  "scripts": {
    "build": "tsdown",
    "fetch-native": "node ./scripts/fetch-native.mjs",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test tests/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2"
  }
}