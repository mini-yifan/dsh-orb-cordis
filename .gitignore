# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo
.turbo/
.cache/

# Compiled from packages/*/src by `pnpm build` — never hand-edited
packages/*/lib/
packages/helper/assets/vendor/

# Package artifacts
*.tgz

# Electron helper runtime (downloaded, not vendored)
.electron/
electron-cache/

# Native modules
*.node
native/**/build/
packages/native-selection/build/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
credentials.json

# Logs and coverage
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# Local agent / tooling state
.cursor/
.zcode/
.zcodeignore

# Assembled by packages/bundle/scripts/assemble.mjs
packages/bundle/lib/
packages/bundle/client.js

# Local probe scratch (scripts/linux-smoke.mjs writes its screenshots here)
.probe/
